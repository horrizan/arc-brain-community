# Arc Brain Community Edition — generated values are written by install.ps1.
ARC_HOME=C:\Users\YOUR_NAME\ArcBrain
ARC_INBOX=C:\Users\YOUR_NAME\ArcBrain\Inbox
ARC_N8N_BASE_URL=http://127.0.0.1:5678
ARC_INTAKE_URL=http://127.0.0.1:5678/webhook/arc/intake
ARC_TELEGRAM_URL=http://127.0.0.1:5678/webhook/arc/telegram
ARC_SENTINEL_STATE=C:\Users\YOUR_NAME\ArcBrain\arc-sentinel.sqlite3
ARC_MAX_INLINE_TEXT_BYTES=524288
ARC_MAX_INLINE_BINARY_MB=8

N8N_VERSION=2.41.3
N8N_PORT=5678
POSTGRES_DB=arcbrain
POSTGRES_USER=arcbrain
POSTGRES_PASSWORD=GENERATED_BY_INSTALLER
N8N_ENCRYPTION_KEY=GENERATED_BY_INSTALLER
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=arcbrain
PGUSER=arcbrain
PGPASSWORD=GENERATED_BY_INSTALLER

OLLAMA_N8N_URL=http://host.docker.internal:11434
OLLAMA_HOST_URL=http://127.0.0.1:11434
# A single installed model can serve all three roles. The installer sets exact-match regexes.
ARC_MODEL_FAST_PATTERN=qwen3\.5:9b
ARC_MODEL_MAIN_PATTERN=qwen3\.5:9b
ARC_MODEL_REASONER_PATTERN=qwen3\.5:9b

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_POLL_TIMEOUT=45
ARC_WOL_MAC=
ARC_WOL_BROADCAST=255.255.255.255
ARC_WAKE_WAIT_SECONDS=75
REMOTE_ARC_TELEGRAM_URL=

ARC_CONTROL_ROOM_HOST=0.0.0.0
ARC_CONTROL_ROOM_PORT=8787
ARC_CONTROL_ROOM_TOKEN=GENERATED_BY_INSTALLER
ARC_CONTROL_ROOM_REQUIRE_TOKEN=true
MEMPALACE_CLI=mempalace
MEMPALACE_SEARCH_TIMEOUT=45
ARC_AGENT_LIBRARY_DIR=
ARC_CODE_REVIEW_URL=http://127.0.0.1:5678/webhook/arc/code-review

ARC_OUTREACH_SEND_ENABLED=false
SMTP_FROM=
